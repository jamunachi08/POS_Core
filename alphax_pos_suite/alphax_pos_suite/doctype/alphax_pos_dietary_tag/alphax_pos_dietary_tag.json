{
  "doctype": "DocType",
  "name": "AlphaX POS Dietary Tag",
  "module": "AlphaX POS Suite",
  "custom": 0,
  "autoname": "field:tag_name",
  "description": "A diet a guest keeps, or an allergen a dish contains. Drives the cashier filter chips and the kitchen ticket warning.",
  "field_order": [
    "tag_name",
    "tag_name_ar",
    "tag_kind",
    "cb0",
    "short_code",
    "colour",
    "show_as_filter",
    "disabled",
    "sec_d",
    "description"
  ],
  "fields": [
    {
      "fieldname": "tag_name",
      "label": "Tag",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "tag_name_ar",
      "label": "Tag (Arabic)",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "tag_kind",
      "label": "Kind",
      "fieldtype": "Select",
      "options": "Diet\nAllergen",
      "default": "Diet",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Diet is what a guest wants (vegan, halal). Allergen is what a dish contains, and it is the one the kitchen must never miss."
    },
    {
      "fieldname": "cb0",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "short_code",
      "label": "Short Code",
      "fieldtype": "Data",
      "description": "Two or three characters for the kitchen ticket, e.g. GF, NUT."
    },
    {
      "fieldname": "colour",
      "label": "Colour",
      "fieldtype": "Color"
    },
    {
      "fieldname": "show_as_filter",
      "label": "Show as a filter at the till",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "disabled",
      "label": "Disabled",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "sec_d",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    }
  ],
  "permissions": [
    {
      "role": "AlphaX POS Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "AlphaX POS Supervisor",
      "read": 1
    },
    {
      "role": "AlphaX POS Cashier",
      "read": 1
    },
    {
      "role": "AlphaX POS Kitchen",
      "read": 1
    }
  ]
}