{
 "doctype": "DocType",
 "name": "AlphaX POS Bridge Install",
 "module": "AlphaX POS Suite",
 "custom": 0,
 "istable": 0,
 "autoname": "format:BRIDGE-{YY}{MM}-{#####}",
 "engine": "InnoDB",
 "allow_rename": 0,
 "track_changes": 0,
